\u0422\u041e:\n1. \u041d\u0418\u041a\u041e\u0413\u0414\u0410 \u043d\u0435 \u043e\u0442\u0432\u0435\u0447\u0430\u0442\u044c \u043d\u0430 \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435 \u0440\u0435\u0444\u043b\u0435\u043a\u0442\u043e\u0440\u043d\u043e. \u0420\u0430\u0437\u0440\u044b\u0432 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0442\u044c 300-310 \u0412\u0442 \u0437\u0430 60-90 \u0441, \u0430 \u043d\u0435 400 \u0412\u0442 \u0437\u0430 20 \u0441. \u0414\u043b\u0438\u043d\u043d\u044b\u0439 \u0441\u043f\u043e\u0441\u043e\u0431 \u0434\u0435\u0448\u0435\u0432\u043b\u0435 \u0432\u0434\u0432\u043e\u0435 \u0438 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0435.\n2. \u041f\u043e\u0434\u044a\u0451\u043c\u044b \u0434\u043b\u0438\u043d\u043d\u0435\u0435 5 \u043c\u0438\u043d \u2014 \u0441\u0432\u043e\u0438 280-295 \u0412\u0442 \u0441\u0438\u0434\u044f. \u041a\u0442\u043e \u0443\u0435\u0445\u0430\u043b \u043d\u0430 \u0440\u044b\u0432\u043a\u0435, \u0432\u0435\u0440\u043d\u0451\u0442\u0441\u044f. \u042d\u0442\u043e \u0435\u0433\u043e \u0442\u0435\u0440\u0440\u0430\u0438\u043d.\n3. \u041a\u043e\u0440\u043e\u0442\u043a\u0438\u0435 \u0442\u044b\u0447\u043a\u0438 1-3 \u043c\u0438\u043d \u2014 \u0445\u0443\u0434\u0448\u0438\u0439 terrain. \u0417\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u0432 \u043d\u0438\u0445 \u0412 \u041f\u0415\u0420\u0412\u041e\u0419 \u0422\u0420\u0415\u0422\u0418 \u0433\u0440\u0443\u043f\u043f\u044b \u0438 \u043f\u0440\u043e\u0441\u0430\u0436\u0438\u0432\u0430\u0442\u044c\u0441\u044f \u043d\u0430\u0437\u0430\u0434 \u043f\u043e \u0445\u043e\u0434\u0443, \u0430 \u043d\u0435 \u0434\u043e\u0433\u043e\u043d\u044f\u0442\u044c \u0441\u0437\u0430\u0434\u0438.\n4. \u041f\u043e\u0437\u0438\u0446\u0438\u044f \u2014 \u0441\u0430\u043c\u044b\u0439 \u0434\u0435\u0448\u0451\u0432\u044b\u0439 \u0441\u043f\u043e\u0441\u043e\u0431 \u0441\u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0442\u044c W'. \u0412 \u043f\u0435\u0440\u0432\u043e\u0439 \u0442\u0440\u0435\u0442\u0438 \u043f\u0435\u0440\u0435\u0434 \u043a\u0430\u0436\u0434\u044b\u043c \u043f\u043e\u0434\u044a\u0451\u043c\u043e\u043c \u0438 \u043a\u0430\u0436\u0434\u044b\u043c \u0442\u0435\u0445\u043d\u0438\u0447\u043d\u044b\u043c \u0443\u0447\u0430\u0441\u0442\u043a\u043e\u043c.\n5. \u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0431\u0430\u043a\u0430: \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0438\u043d\u0443\u0442 \u042f\u0412\u041d\u041e \u043d\u0438\u0436\u0435 CP (~200 \u0412\u0442). \u041d\u0435 260 \u0412\u0442 \u00ab\u043f\u043e\u043b\u0435\u0433\u0447\u0435\u00bb.\n\n\u041f\u0415\u0419\u0421\u0418\u041d\u0413: \u0446\u0435\u043b\u044c NP 210-225 (IF 0.72-0.77), \u043e\u0436\u0438\u0434\u0430\u0435\u043c\u043e\u0435 \u0432\u0440\u0435\u043c\u044f 4:50-5:30, TSS 280-320.\n\u041f\u0415\u0420\u0412\u042b\u0419 \u0427\u0410\u0421 \u2014 \u0416\u0401\u0421\u0422\u041a\u041e: NP <=210, \u041d\u0418\u0427\u0415\u0413\u041e \u0432\u044b\u0448\u0435 330 \u0412\u0442. \u0413\u043e\u043d\u043a\u0438 \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0432\u0430\u044e\u0442 \u0432 \u043f\u0435\u0440\u0432\u044b\u0439 \u0447\u0430\u0441, \u0441\u0436\u0438\u0433\u0430\u044f \u0441\u043f\u0438\u0447\u043a\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u043d\u0435\u0442.\n\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 20 \u043a\u043c \u2014 \u043c\u043e\u0436\u043d\u043e \u0434\u043e 300-310 \u043d\u0430 \u043f\u043e\u0434\u044a\u0451\u043c\u0430\u0445, \u0435\u0441\u043b\u0438 \u0431\u0430\u043a \u0446\u0435\u043b.\n\n\u041f\u0418\u0422\u0410\u041d\u0418\u0415: 90-100 \u0433/\u0447 \u043f\u043e \u0442\u0430\u0439\u043c\u0435\u0440\u0443 (\u043e\u0431\u043a\u0430\u0442\u0430\u043d\u043e \u043d\u0430 \u0434\u043b\u0438\u043d\u043d\u044b\u0445), 750-1000 \u043c\u043b/\u0447, \u043d\u0430\u0442\u0440\u0438\u0439 700-1000 \u043c\u0433/\u0447, \u0432 \u0436\u0430\u0440\u0443 +300-500. \u041d\u0418\u0427\u0415\u0413\u041e \u041d\u041e\u0412\u041e\u0413\u041e.\n\u041a\u043e\u0444\u0435\u0438\u043d 210 \u043c\u0433 \u0437\u0430 60 \u043c\u0438\u043d \u0434\u043e \u0441\u0442\u0430\u0440\u0442\u0430. NaHCO3 \u041d\u0415 \u0431\u0440\u0430\u0442\u044c \u2014 \u043d\u0438 \u043e\u0434\u043d\u043e\u0439 \u043f\u0440\u043e\u0431\u044b \u043d\u0435 \u0431\u044b\u043b\u043e.\n\u0417\u0430\u0432\u0442\u0440\u0430\u043a \u0437\u0430 2 \u0447: 70-105 \u0433 \u0443\u0433\u043b\u0435\u0432\u043e\u0434\u043e\u0432, \u043d\u0438\u0437\u043a\u0430\u044f \u043a\u043b\u0435\u0442\u0447\u0430\u0442\u043a\u0430, \u043f\u0440\u0438\u0432\u044b\u0447\u043d\u043e\u0435.\n\nGO / NO-GO: \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c \u0441\u0442\u0430\u0440\u0442 \u043c\u043e\u0433\u0443\u0442 \u0422\u041e\u041b\u042c\u041a\u041e \u0431\u043e\u043b\u0435\u0437\u043d\u044c \u0438\u043b\u0438 \u0442\u0440\u0430\u0432\u043c\u0430. \u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430, \u043e\u0441\u0442\u0440\u0430\u044f \u0442\u0440\u0430\u0432\u043c\u0430, \u0416\u041a\u0422 -> DNS. HRV \u0438 \u0441\u043e\u043d \u0443\u0442\u0440\u043e\u043c \u043f\u0438\u0448\u0435\u043c \u0432 \u043b\u043e\u0433, \u0432 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043e\u043d\u0438 \u041d\u0415 \u0432\u0445\u043e\u0434\u044f\u0442 \u2014 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0440\u0442\u043e\u0432\u043e\u0435 \u043f\u0430\u0434\u0435\u043d\u0438\u0435 HRV \u044d\u0442\u043e \u0441\u0438\u043c\u043f\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0433\u043e\u0442\u043e\u0432\u043d\u043e\u0441\u0442\u044c, \u0430 \u043d\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430."
    }
